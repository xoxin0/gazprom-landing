# Скопируйте файл в .env и подставьте свой токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram ID администратора. Локально не нужен — админом становится первый
# написавший боту. На хостинге задайте обязательно: там диск сбрасывается
# при деплое, и без этой переменной место администратора освободится.
TELEGRAM_ADMIN_ID=

# Необязательные параметры
PORT=5173
HOST=127.0.0.1
